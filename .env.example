# Copy to .env. Used by docker compose (interpolation + env_file) and by local runs.

# --- Database ---
# Compose creates the Postgres role/db from these three on FIRST volume init only;
# changing the password later requires `docker compose down -v` (wipes data) or ALTER ROLE.
POSTGRES_USER=redline
POSTGRES_PASSWORD=redline_dev_password
POSTGRES_DB=redline
# Host-side access to the compose Postgres (published on 5433 to avoid clashing with a local 5432).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# For processes on the host. Containers override this with host `postgres`, port 5432.
DATABASE_URL=postgresql+psycopg2://redline:redline_dev_password@localhost:5433/redline
# No Docker? `python scripts/dev_db.py` starts an embedded Postgres and writes DATABASE_URL here.

# --- Auth ---
# Set a long random value (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# 5173 = vite dev server, 8080 = dockerised dashboard.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# --- Dashboard build ---
# Browser-visible API URL baked into the dashboard image at build time.
VITE_API_URL=http://localhost:8000

# --- LLM provider (used by the RAG agent + the llm_judge scorer) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# --- GitHub Checks integration (only used by `agentbench ci-check` inside Actions) ---
GITHUB_TOKEN=
