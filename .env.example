# --- Database ---
POSTGRES_USER=redline
POSTGRES_PASSWORD=redline_dev_password
POSTGRES_DB=redline
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# 127.0.0.1, not localhost: Postgres's pg_hba.conf has separate rules for the
# 127.0.0.1/32 and ::1/128 loopback addresses, and on a dual-stack machine
# "localhost" can resolve to ::1 first. If that rule ever falls out of sync with
# the IPv4 one (as it did during Phase 3 development), every DB connection fails
# with "password authentication failed" despite a correct password. Pinning to
# the literal IPv4 address sidesteps the ambiguity entirely.
DATABASE_URL=postgresql+psycopg2://redline:redline_dev_password@127.0.0.1:5432/redline

# Opt-in (Phase 5.1): point at PgBouncer instead of Postgres directly, and set
# DB_USE_EXTERNAL_POOLER=true so SQLAlchemy uses NullPool instead of double-
# pooling on top of PgBouncer's own pool. Not the default -- see
# docs/infra-hardening.md for why. Uncomment both lines together to switch on:
# DATABASE_URL=postgresql+psycopg2://redline:redline_dev_password@127.0.0.1:6432/redline
DB_USE_EXTERNAL_POOLER=false

# --- Auth ---
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- LLM provider (used by the RAG agent + the llm_judge scorer) ---
ANTHROPIC_API_KEY=

# --- GitHub Checks integration (added in Section 12, not needed yet) ---
GITHUB_TOKEN=

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Redpanda ---
REDPANDA_BOOTSTRAP_SERVERS=localhost:19092

# --- Topics ---
TOPIC_EVAL_REQUESTED=eval.requested
TOPIC_EVAL_COMPLETED=eval.completed
TOPIC_TRACE_EMITTED=trace.emitted

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=redline
# Phase 5.1: least-privilege app identity (SELECT, INSERT only), not the
# container's superuser. See docs/infra-hardening.md.
CLICKHOUSE_USER=redline_app
CLICKHOUSE_PASSWORD=redline_app_dev_password
# Bootstrap-only, used solely by `python -m apps.api.scripts.init_clickhouse`
# to create the database/tables/app-user above. Matches the container's own
# CLICKHOUSE_USER/CLICKHOUSE_PASSWORD env vars below, which stay unrelated to
# and untouched by this change.
CLICKHOUSE_ADMIN_USER=default
CLICKHOUSE_ADMIN_PASSWORD=redline_dev

# --- Tracing (Phase 5.1: OTLP -> Grafana Tempo) ---
OTEL_EXPORTER_ENDPOINT=http://localhost:4317